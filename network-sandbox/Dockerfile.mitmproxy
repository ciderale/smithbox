FROM mitmproxy/mitmproxy


RUN cat <<'EOF' > /entrypoint.sh \
    && chmod +x /entrypoint.sh
#!/usr/bin/env bash
set -eu

set -x;
export PYTHONUNBUFFERED=1

rm -f /proxy-ca/mitmproxy-ca.crt
timeout 1 mitmdump --set confdir=/.mitmproxy || true;
cp /.mitmproxy/mitmproxy-ca-cert.pem /proxy-ca/mitmproxy-ca.crt;

ARGS=(
    --listen-host 0.0.0.0
    --listen-port 3128
    --set confdir=/.mitmproxy
)

if [ -n "${WEB_PASSWORD:-}" ]; then
    ARGS+=(
        --web-host 0.0.0.0
        --web-port 8081
        --set "web_password=$WEB_PASSWORD"
    )
fi
for rule in ${RULE_FILES:-}; do
    ARGS+=(-s "$rule")
done

exec mitmweb "${ARGS[@]}"
EOF

RUN cat <<'EOF' > /mitm.rules.py
import os
import re
from mitmproxy import http, ctx


def env_set(name: str) -> set[str]:
    env_value = os.getenv(name, "").strip()
    env_value_split = re.split(r"[\s,]+", env_value)
    return {
        value.strip().lower()
        for value in env_value_split
        if value.strip()
    }

DENY = env_set("HTTP_DENY_ALL")
ALLOW = env_set("HTTP_ALLOW_ALL")
SAFE_METHODS = env_set("HTTP_SAFE_METHODS")

def matches(host: str, hosts: set[str]):
    return any(host == h or host.endswith("." + h) for h in hosts)

ctx.log.info(f"Allow all: {ALLOW}")
ctx.log.info(f"Deny all: {DENY}")
ctx.log.info(f"Default allowed method: {SAFE_METHODS}")

def request(flow: http.HTTPFlow):
    host = flow.request.pretty_host.lower()
    method = flow.request.method.lower()

    def deny():
        flow.response = http.Response.make(
            403,
            b"Blocked by proxy policy\n",
            {"Content-Type": "text/plain"},
        )

    if matches(host, DENY):
        deny()
    elif matches(host, ALLOW):
        return
    elif method not in SAFE_METHODS:
        deny()
EOF

RUN cat <<'EOF' > /mitm.auth.py
import os
from pathlib import Path

import yaml
from mitmproxy import http


def make_matcher(match):
    host = match["host"].lower()
    port = match.get("port")

    def matcher(flow):
        return (
            flow.request.host.lower() == host
            and (port is None or flow.request.port == port)
        )

    return matcher


def make_applyauth(auth):
    secret = Path("/run/secrets", auth["secret"]).read_text().strip()

    if auth["scheme"] == "bearer":
        value = f"Bearer {secret}"
    elif auth["scheme"] == "basic":
        value = f"{secret}"
    else:
        raise ValueError(f"Unknown auth scheme: {auth['scheme']}")

    def applyauth(flow):
        flow.request.headers["Authorization"] = value

    return applyauth


def load_auth():
    config = yaml.safe_load(os.environ.get("AUTH_CONFIG", "rules: []"))

    return [
        {
            "matcher": make_matcher(rule["match"]),
            "applyauth": make_applyauth(rule["auth"]),
        }
        for rule in config["rules"]
    ]


RULES = load_auth()


def request(flow: http.HTTPFlow):
    for rule in RULES:
        if rule["matcher"](flow):
            rule["applyauth"](flow)
            return

EOF

RUN pip install --no-cache-dir PyYAML

ENTRYPOINT [ "/entrypoint.sh" ]
